def speak(x) :
    engin.setProperty('rate',150)
    engin.say(x)
    engin.runAndWait()
def sound_recognition() :
    rec=sr.Recognizer()
    with sr.Microphone() as mic :
        rec.adjust_for_ambient_noise(mic,duration=3)
        try:
             y=rec.listen(mic)
             txt=rec.recognize_google(y)
             return txt
        except sr.UnknownValueError :
            print("you dont speak sir pleas speak")
            speak("you dont speak sir pleas speak")
        except Exception as e:
            print(f"there are erro happen :{e}")    
def match_command1(user_text):
    result = process.extractOne(user_text, lista1, score_cutoff=15)
    if result:
        return result[0]   # اسم الخيار الأقرب
    return user_text
